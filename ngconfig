# Location :- /etc/nginx/nginx.conf

# trustedSales
events {}

http {
    include       mime.types;
    default_type  application/octet-stream;

    server {
        listen 80;
        server_name brandkit.plaper.org;

        root /usr/share/nginx/html/brandkit;
        index index.html;

        # Serve static files (CSS/JS/images) directly, 404 if not found
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
            try_files $uri =404;
        }

        # SPA fallback for everything else
        location / {
            try_files $uri $uri/ /index.html;
        }
    }

